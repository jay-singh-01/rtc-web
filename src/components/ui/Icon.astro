---
import { ICONS } from "@/lib/icons";
import type { IconName } from "@/types";

interface Props { name: IconName; class?: string; strokeWidth?: number }
const { name, class: cls = "size-5", strokeWidth = 1.8 } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[name]} />
