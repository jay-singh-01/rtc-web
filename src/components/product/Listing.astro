---
import Icon from "@/components/ui/Icon.astro";
import ProductCard from "@/components/product/ProductCard.astro";
import { categories, materials } from "@/content/taxonomy";
import type { Product } from "@/types";

interface Props { products: Product[]; activeCat?: string; title: string; blurb: string }
const { products, activeCat, title, blurb } = Astro.props;
const matsHere = materials.filter((m) => products.some((p) => p.material === m.id));
const sorts = [
  { v: "popular", l: "Popular first" },
  { v: "az", l: "Name A–Z" },
  { v: "za", l: "Name Z–A" },
  { v: "eco", l: "Eco-friendly first" },
];
---
<section class="relative overflow-hidden bg-cream">
  <div class="pointer-events-none absolute -top-32 -right-32 size-96 rounded-full bg-sun/25 blur-3xl" aria-hidden="true"></div>
  <div class="wrap relative pt-6 pb-8 sm:pt-10 sm:pb-12">
    <nav class="mb-4 flex flex-wrap gap-2 text-[13px] text-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink">Home</a><span aria-hidden="true">/</span>
      {activeCat ? <><a href="/products" class="hover:text-ink">Products</a><span aria-hidden="true">/</span><span class="text-ink" aria-current="page">{title}</span></> : <span class="text-ink" aria-current="page">Products</span>}
    </nav>
    <h1 class="text-[clamp(34px,7vw,64px)] leading-[.98] font-extrabold" data-listing-title data-reveal>{title}</h1>
    <p class="mt-3 max-w-xl text-[16px] text-ink-2" data-listing-blurb data-reveal>{blurb}</p>
  </div>
</section>

<!-- Sticky tools: category chips + search + filters -->
<div class="sticky top-16 z-40 border-b border-line bg-white/90 backdrop-blur-xl lg:top-[76px]" data-listing-bar>
  <div class="wrap">
    <div class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 py-3 sm:mx-0 sm:px-0">
      <a href="/products" class:list={["flex-none rounded-full px-4 py-2 text-[14px] font-semibold ring-1 transition", !activeCat ? "bg-ink text-white ring-ink" : "bg-white ring-line hover:ring-ink"]}>All</a>
      {categories.map((c) => (
        <a href={`/category/${c.id}`} class:list={["flex-none rounded-full px-4 py-2 text-[14px] font-semibold ring-1 transition", activeCat === c.id ? "bg-ink text-white ring-ink" : "bg-white ring-line hover:ring-ink"]} aria-current={activeCat === c.id ? "page" : undefined}>{c.short}</a>
      ))}
    </div>
    <div class="flex items-center gap-2 pb-3">
      <label class="relative flex-1">
        <span class="sr-only">Search in {title}</span>
        <Icon name="search" class="pointer-events-none absolute top-1/2 left-4 size-[18px] -translate-y-1/2 text-muted" />
        <input type="search" data-listing-q enterkeyhint="search" autocomplete="off" placeholder={`Search ${activeCat ? title.toLowerCase() : "products"} or codes…`} class="field rounded-full py-3 pl-11 text-[15px]" />
      </label>
      <button type="button" data-sheet-open="sheet-filters" class="relative flex h-[46px] flex-none items-center gap-2 rounded-full bg-ink px-4 text-[14px] font-semibold text-white transition active:scale-95">
        <Icon name="filter" class="size-[18px]" /><span class="max-sm:hidden">Filters</span>
        <span data-filter-count hidden class="grid size-5 place-items-center rounded-full bg-brand text-[11px] font-bold">0</span>
      </button>
    </div>
  </div>
</div>

<section class="wrap pt-5 pb-20">
  <div class="mb-4 flex flex-wrap items-center gap-2">
    <p class="mr-auto text-[14px] text-muted" aria-live="polite"><b class="text-ink" data-listing-count>{products.length}</b> products</p>
    <div class="flex flex-wrap gap-2" data-active-filters></div>
  </div>
  <div class="grid grid-cols-2 gap-x-3 gap-y-7 sm:grid-cols-3 sm:gap-x-5 lg:grid-cols-4" data-listing-grid>
    {products.map((p, i) => <ProductCard product={p} filterable index={i} eager={i < 4} />)}
  </div>
  <div data-listing-empty hidden class="mt-4 rounded-[28px] border-2 border-dashed border-line px-6 py-16 text-center">
    <p class="font-display text-2xl font-bold">Nothing matches that</p>
    <p class="mx-auto mt-2 max-w-sm text-muted">Try a different word or clear filters. We stock more than what's online — just ask us.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-2">
      <button type="button" class="btn btn-ghost" data-filter-reset>Clear filters</button>
      <a class="btn btn-wa" data-listing-ask target="_blank" rel="noopener" href="https://wa.me/918618457240"><Icon name="whatsapp" /> Ask on WhatsApp</a>
    </div>
  </div>
</section>

<!-- Filters sheet -->
<section id="sheet-filters" class="sheet" role="dialog" aria-modal="true" aria-label="Filters" aria-hidden="true" inert>
  <div class="sheet-handle"></div>
  <div class="flex items-center justify-between px-5 pt-3 pb-2">
    <h2 class="text-[22px]">Filters</h2>
    <button type="button" class="grid size-10 place-items-center rounded-full bg-cream" data-sheet-close aria-label="Close"><Icon name="close" /></button>
  </div>
  <div class="sheet-body px-5 pb-4">
    <fieldset class="mb-7">
      <legend class="label mb-3">Material</legend>
      <div class="flex flex-wrap gap-2">
        {matsHere.map((m) => (
          <button type="button" data-filter-mat={m.id} aria-pressed="false" class="chip-opt min-h-0 flex-row items-center gap-2 px-4 py-2.5 text-[14px] font-semibold">
            {m.eco && <Icon name="leaf" class="size-4 text-eco" />}{m.name} <span class="text-[12px] font-medium text-muted" data-mat-n={m.id}></span>
          </button>
        ))}
      </div>
    </fieldset>
    <fieldset class="mb-7">
      <legend class="label mb-3">Preference</legend>
      <button type="button" data-filter-eco aria-pressed="false" class="chip-opt min-h-0 w-full flex-row items-center justify-between px-4 py-3.5">
        <span class="flex items-center gap-2.5 font-semibold"><Icon name="leaf" class="size-5 text-eco" /> Eco-friendly only</span>
        <span class="relative h-7 w-12 rounded-full bg-line transition [[aria-pressed=true]_&]:bg-eco"><span class="absolute top-1 left-1 size-5 rounded-full bg-white shadow transition [[aria-pressed=true]_&]:translate-x-5"></span></span>
      </button>
    </fieldset>
    <fieldset>
      <legend class="label mb-3">Sort by</legend>
      <div class="grid grid-cols-2 gap-2">
        {sorts.map((s, i) => <button type="button" data-filter-sort={s.v} aria-pressed={i === 0 ? "true" : "false"} class="chip-opt min-h-0 px-4 py-3 text-[14px] font-semibold">{s.l}</button>)}
      </div>
    </fieldset>
  </div>
  <div class="grid grid-cols-[auto_1fr] gap-2 border-t border-line p-4">
    <button type="button" class="btn btn-ghost" data-filter-reset>Reset</button>
    <button type="button" class="btn btn-ink" data-sheet-close>Show <span data-filter-show>{products.length}</span> products</button>
  </div>
</section>

<script>
  import "@/scripts/listing";
</script>
