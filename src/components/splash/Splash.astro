---
import { getImage } from "astro:assets";
import { img } from "@/lib/images";
import { site } from "@/content/site";

const logo = await getImage({ src: img("logo"), width: 200, format: "webp" });
const letters = [...site.name];
---
<!-- Yellow follow-through curtain (lifts just after the orange splash). -->
<div id="sp-curtain-2" class="fixed inset-0 z-[199] bg-sun" aria-hidden="true"></div>
<div id="splash" aria-hidden="true">
  <div id="sp-stage" class="flex flex-col items-center px-6">
    <svg id="sp-box" viewBox="0 0 240 230" class="w-[min(68vw,300px)] overflow-visible" role="presentation">
      <defs><clipPath id="sp-logo-clip"><circle cx="120" cy="167" r="27" /></clipPath></defs>
      <!-- box opening (inside) -->
      <path d="M44 125 H196 L188 136 H52 Z" fill="#8a5a2b" />
      <!-- items that drop in -->
      <g data-sp-item>
        <rect x="100" y="38" width="7" height="92" rx="3.5" fill="#fff" transform="rotate(-8 103 84)" />
        <rect x="100" y="48" width="7" height="10" fill="#f26a1b" transform="rotate(-8 103 84)" />
        <rect x="100" y="70" width="7" height="10" fill="#f26a1b" transform="rotate(-8 103 84)" />
        <rect x="100" y="92" width="7" height="10" fill="#f26a1b" transform="rotate(-8 103 84)" />
      </g>
      <g data-sp-item>
        <circle cx="150" cy="112" r="32" fill="#fff" />
        <circle cx="150" cy="112" r="22" fill="none" stroke="#efe6da" stroke-width="3" />
      </g>
      <g data-sp-item>
        <path d="M58 84 H96 L91 140 H63 Z" fill="#fff" />
        <path d="M60 102 H94 L92 120 H62 Z" fill="#fdb515" />
        <rect x="55" y="79" width="44" height="7" rx="3.5" fill="#fff" stroke="#efe6da" />
      </g>
      <g data-sp-item>
        <rect x="160" y="88" width="44" height="40" rx="9" fill="#fff" transform="rotate(10 182 108)" />
        <path d="M162 104 H202" stroke="#e7ddd0" stroke-width="2.5" transform="rotate(10 182 108)" />
      </g>
      <!-- front of the box -->
      <path d="M44 125 H196 L186 208 Q185 214 179 214 H61 Q55 214 54 208 Z" fill="#c9965f" />
      <path d="M50 186 H190 L186 208 Q185 214 179 214 H61 Q55 214 54 208 Z" fill="#b8844d" opacity=".55" />
      <!-- flaps -->
      <path id="sp-flap-l" d="M44 125 H120 V103 H52 Z" fill="#dcae7a" />
      <path id="sp-flap-r" d="M120 125 H196 L188 103 H120 Z" fill="#d2a06a" />
      <!-- logo stamp -->
      <g id="sp-logo">
        <circle cx="120" cy="167" r="30" fill="#fff" />
        <image href={logo.src} x="93" y="140" width="54" height="54" clip-path="url(#sp-logo-clip)" />
      </g>
    </svg>
    <p class="mt-7 overflow-hidden font-display text-[clamp(22px,6vw,34px)] leading-none font-extrabold tracking-tight text-white" aria-label={site.name}>
      {letters.map((l) => <span data-sp-letter class="inline-block">{l === " " ? " " : l}</span>)}
    </p>
    <p id="sp-tag" class="mt-3 text-[13px] font-semibold tracking-[.28em] text-white/85 uppercase">{site.tagline} · Raichur</p>
  </div>
  <span class="absolute bottom-[max(24px,env(safe-area-inset-bottom))] text-[12px] font-medium tracking-wide text-white/70">Tap to skip</span>
</div>
