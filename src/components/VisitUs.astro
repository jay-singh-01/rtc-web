---
import Icon from "@/components/ui/Icon.astro";
import { addressText, mailHref, mapsHref, site, telHref, waHref } from "@/content/site";

const cards = [
  { href: waHref(), icon: "whatsapp" as const, title: "WhatsApp", sub: `${site.phoneDisplay} · quickest reply`, tone: "bg-[#e3f9eb] text-wa-600", ext: true },
  { href: telHref, icon: "phone" as const, title: "Call us", sub: site.phoneDisplay, tone: "bg-brand-50 text-brand-600" },
  { href: mailHref, icon: "mail" as const, title: "Email", sub: site.email, tone: "bg-brand-50 text-brand-600" },
  { href: mapsHref, icon: "pin" as const, title: "Visit our store", sub: addressText, tone: "bg-sun-50 text-ink", ext: true, cta: "Get directions" },
];
---
<div class="grid gap-5 lg:grid-cols-[1fr_1.15fr]">
  <div class="grid gap-3">
    {cards.map((c) => (
      <a href={c.href} target={c.ext ? "_blank" : undefined} rel="noopener" class="group flex items-center gap-4 rounded-[22px] bg-white p-4 ring-1 ring-line transition hover:ring-ink active:scale-[.98] sm:p-5" data-reveal>
        <span class:list={["grid size-12 flex-none place-items-center rounded-2xl", c.tone]}><Icon name={c.icon} class="size-[22px]" /></span>
        <span class="min-w-0 flex-1">
          <span class="block font-semibold">{c.title}</span>
          <span class="block text-[14px] text-muted">{c.sub}</span>
          {c.cta && <span class="mt-1 inline-block text-[13.5px] font-semibold text-brand-600">{c.cta} →</span>}
        </span>
        <Icon name="right" class="size-5 flex-none text-muted transition group-hover:translate-x-1" />
      </a>
    ))}
    {site.hours && <div class="flex items-center gap-4 rounded-[22px] bg-white p-5 ring-1 ring-line"><span class="grid size-12 place-items-center rounded-2xl bg-cream"><Icon name="clock" /></span><span><b class="block">Store hours</b><span class="text-[14px] text-muted">{site.hours}</span></span></div>}
  </div>
  <div class="min-h-[320px] overflow-hidden rounded-[28px] ring-1 ring-line" data-reveal>
    <iframe title="RTC location on Google Maps" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="size-full min-h-[320px] border-0" src={`https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&output=embed`}></iframe>
  </div>
</div>
