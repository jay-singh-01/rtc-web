---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
---
<BaseLayout title="Page not found">
  <section class="wrap flex min-h-[70dvh] flex-col items-center justify-center py-20 text-center">
    <p class="font-display text-[clamp(110px,26vw,220px)] leading-none font-extrabold text-brand" data-reveal="scale">404</p>
    <h1 class="mt-2 text-[clamp(26px,5vw,40px)]" data-reveal>This box is empty.</h1>
    <p class="mt-3 max-w-md text-muted" data-reveal>The page you're looking for has moved or doesn't exist. Let's get you back to the good stuff.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3" data-reveal>
      <a href="/products" class="btn btn-brand">Browse products <Icon name="arrow" /></a>
      <button type="button" data-sheet-open="sheet-search" class="btn btn-ghost"><Icon name="search" /> Search</button>
    </div>
  </section>
</BaseLayout>
