---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import { img } from "@/lib/images";
import { catalogues } from "@/lib/catalogues";
import { instagramHref, mailHref, site, telHref, waHref } from "@/content/site";
import type { IconName } from "@/types";

const links: { href: string; icon: IconName; title: string; sub: string; tone?: string; ext?: boolean }[] = [
  { href: waHref(), icon: "whatsapp", title: "Chat on WhatsApp", sub: site.phoneDisplay, tone: "bg-wa text-white", ext: true },
  { href: "/products", icon: "grid", title: "Browse all products", sub: "Sizes, codes & enquiry list" },
  { href: "/products?eco=1", icon: "leaf", title: "Eco-friendly range", sub: "Sugarcane, cornstarch, clay & wood" },
  { href: telHref, icon: "phone", title: "Call us", sub: site.phoneDisplay },
  { href: instagramHref, icon: "instagram", title: "Instagram", sub: `@${site.instagram}`, ext: true },
  { href: mailHref, icon: "mail", title: "Email", sub: site.email },
  { href: "/contact", icon: "pin", title: "Visit our store", sub: "Gunj Road, Raichur" },
];
---
<BaseLayout title="Links" description={`WhatsApp, call, Instagram and product catalogues for ${site.name}, Raichur.`} bare>
  <div class="min-h-dvh bg-[radial-gradient(120%_70%_at_50%_0%,#fff4e6_0%,#ffd9b8_45%,#fdb515_100%)] px-4 py-12">
    <div class="mx-auto max-w-md text-center">
      <Image src={img("logo")} alt={`${site.short} logo`} width={220} height={220} class="mx-auto size-28 rounded-full shadow-2xl ring-4 ring-white" loading="eager" data-reveal="scale" />
      <h1 class="mt-5 text-[26px] font-extrabold" data-reveal>{site.name}</h1>
      <p class="mt-1 text-ink-2" data-reveal>{site.tagline} · Raichur</p>
      <div class="mt-8 grid gap-3">
        {links.map((l) => (
          <a href={l.href} target={l.ext ? "_blank" : undefined} rel="noopener" class:list={["flex items-center gap-3.5 rounded-[22px] p-3 text-left shadow-[0_10px_30px_-14px_rgba(0,0,0,.35)] transition hover:-translate-y-0.5 active:scale-[.98]", l.tone ?? "bg-white"]} data-reveal>
            <span class:list={["grid size-12 flex-none place-items-center rounded-2xl", l.tone ? "bg-white/20" : "bg-brand-50 text-brand-600"]}><Icon name={l.icon} class="size-[22px]" /></span>
            <span class="flex-1"><b class="block">{l.title}</b><span class:list={["text-[13px]", l.tone ? "text-white/85" : "text-muted"]}>{l.sub}</span></span>
            <Icon name="right" class="size-5 opacity-60" />
          </a>
        ))}
        <p class="mt-5 text-[12.5px] font-bold tracking-[.18em] text-ink-2 uppercase" data-reveal>Catalogues</p>
        {catalogues.map((c) => (
          <a href={c.pdf} target="_blank" rel="noopener" class="flex items-center gap-3.5 rounded-[22px] bg-white p-3 text-left shadow-[0_10px_30px_-14px_rgba(0,0,0,.35)] transition hover:-translate-y-0.5" data-reveal>
            <Image src={img(c.cover)} alt="" width={96} height={128} class="h-14 w-11 flex-none rounded-lg object-cover object-top" />
            <span class="flex-1"><b class="block leading-tight">{c.title}</b><span class="text-[13px] text-muted">PDF · {c.pages} pages · {c.size}</span></span>
            <Icon name="download" class="size-5 opacity-60" />
          </a>
        ))}
      </div>
      <a href="/" class="mt-10 inline-block text-[13px] font-semibold text-ink-2 underline underline-offset-4">rtcdisposal.in</a>
    </div>
  </div>
</BaseLayout>
